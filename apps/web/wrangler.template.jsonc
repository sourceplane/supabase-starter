// Rendered to wrangler.jsonc (git-ignored) by tooling/wire: the verify lane
// renders from wiring.fixture.json, the deploy lane from the wiring document
// the `supabase` Terraform root lease-publishes (WIRING_SUPABASE_<ENV>). The
// workers-assets composition deploys one environment per job with no wrangler
// `--env`, so `__ENV__` names the environment this config is rendered for.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "supabase-starter-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // The Supabase project the Worker talks to. The publishable (anon) key is
  // public by design — Row Level Security protects the data — so it is a var,
  // not a secret. Server code reads these through process.env, exactly as the
  // template does on Vercel.
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "@@wiring(supabase/__ENV__:supabase_url)@@",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "@@wiring(supabase/__ENV__:supabase_anon_key)@@"
  }
}
