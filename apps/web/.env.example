# Local development (`pnpm --filter @app/web dev`). Values from your Supabase
# project's settings > API. Copy to .env.local (git-ignored). The Worker gets
# the same two values as wrangler vars, rendered from the wiring document.
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
