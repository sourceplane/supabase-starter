# Local development (`pnpm --filter @app/web dev`, and `pnpm build`, which
# inlines these into the browser bundle). Values from your Supabase project's
# settings > API. Copy to .env.local (git-ignored). Without it, `next dev`
# shows the template's "connect Supabase" steps and `pnpm build` uses the
# committed wrangler.jsonc's (offline fixture) values. The deployed Worker gets
# the same two values as wrangler vars, rendered from the wiring document.
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
